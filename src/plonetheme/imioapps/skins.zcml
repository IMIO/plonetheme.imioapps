<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:cmf="http://namespaces.zope.org/cmf"
    i18n_domain="plonetheme.imioapps">

  <!-- images served at the portal root (portal_url/spinner_small.gif...) -->
  <cmf:registerDirectory name="imioapps_images" />
  <cmf:registerDirectory name="plonemeetingskin_images" />
  <cmf:registerDirectory name="dmsmailskin_images" />
  <cmf:registerDirectory name="pstskin_images" />
  <cmf:registerDirectory name="urbanskin_images" />

</configure>
