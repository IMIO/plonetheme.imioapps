<?xml version="1.0"?>
<registry>
  <records interface="plonetheme.imioapps.interfaces.IPlonethemeImioappsSettings">
  </records>
  <!-- depends "all": rendered after the Diazo theme CSS, so the theme rules win over Barceloneta -->
  <records prefix="plone.bundles/plonetheme.imioapps"
           interface="plone.base.interfaces.resources.IBundleRegistry">
    <value key="enabled">True</value>
    <value key="depends">all</value>
    <value key="csscompilation">++plone++plonetheme.imioapps/imioapps.css</value>
    <value key="jscompilation">++plone++plonetheme.imioapps/skin.js</value>
    <value key="load_async">False</value>
    <value key="load_defer">True</value>
  </records>
</registry>
