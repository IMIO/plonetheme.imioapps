<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.imioapps">

    <!-- zope2.View -->
    <include package="Products.CMFCore" file="permissions.zcml" />

    <!-- ++plone++plonetheme.imioapps/... (bundles in profiles/*/registry.xml) -->
    <plone:static
        name="plonetheme.imioapps"
        directory="static"
        type="plone"
        />

    <!-- global messages out of the sticky header, above the content (Barceloneta's Diazo rules drop
         plone.portaltop): the original in plone.portalheader is hidden by profiles/default/viewlets.xml -->
    <configure package="collective.messagesviewlet.browser">
        <browser:viewlet
            for="*"
            layer="plonetheme.imioapps.interfaces.IThemeSpecific"
            name="message-viewlet"
            manager="plone.app.layout.viewlets.interfaces.IAboveContent"
            class="collective.messagesviewlet.browser.messagesviewlet.GlobalMessagesViewlet"
            template="messagesviewlet.pt"
            permission="zope2.View" />
    </configure>

    <browser:viewlet
        name="plonetheme.imioapps.help"
        manager="plone.app.layout.viewlets.interfaces.IPortalHeader"
        class=".viewlets.HelpViewlet"
        permission="zope2.View"
        />

</configure>
